# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1a1d22"

# Main text color
theme[main_fg]="#ddd4c3"

# Title color for boxes
theme[title]="#ddd4c3"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c7a15e"

# Background color of selected item in processes box
theme[selected_bg]="#3d4a5e"

# Foreground color of selected item in processes box
theme[selected_fg]="#ece4d4"

# Color of inactive/disabled text
theme[inactive_fg]="#958d82"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#e8e0d0"

# Background color of the percentage meters
theme[meter_bg]="#3d4a5e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e8e0d0"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#c08f8c"
theme[mem_box]="#8aa66f"
theme[net_box]="#da6753"
theme[proc_box]="#c7a15e"

# Box divider line and small boxes line color
theme[div_line]="#958d82"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#8aa66f"
theme[temp_mid]="#d6b777"
theme[temp_end]="#da6753"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#7ea6af"
theme[cpu_mid]="#8299cf"
theme[cpu_end]="#c08f8c"

# Mem/Disk free meter
theme[free_start]="#c08f8c"
theme[free_mid]="#8299cf"
theme[free_end]="#7ea6af"

# Mem/Disk cached meter
theme[cached_start]="#8299cf"
theme[cached_mid]="#7ea6af"
theme[cached_end]="#c08f8c"

# Mem/Disk available meter
theme[available_start]="#d6b777"
theme[available_mid]="#da6753"
theme[available_end]="#da6753"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#8aa66f"
theme[used_mid]="#7ea6af"
theme[used_end]="#8299cf"

# Download graph colors
theme[download_start]="#d6b777"
theme[download_mid]="#da6753"
theme[download_end]="#da6753"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#8aa66f"
theme[upload_mid]="#7ea6af"
theme[upload_end]="#8299cf"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#7ea6af"
theme[process_mid]="#8299cf"
theme[process_end]="#c08f8c"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#1a1d22"
theme[gradient_color_1]="#2a2e35"
theme[gradient_color_2]="#3d4a5e"
theme[gradient_color_3]="#958d82"
theme[gradient_color_4]="#aca395"
theme[gradient_color_5]="#ddd4c3"
theme[gradient_color_6]="#e8e0d0"
theme[gradient_color_7]="#f4efe4"
